<section class="rr-hero">
    <div class="container rr-hero-inner">
        <div class="rr-hero-badges mb-3">
            <span class="rr-badge"><i class="fas fa-hotel"></i>Hotel in Kargil</span>
            <span class="rr-badge"><i class="fas fa-mountain"></i>Mountain and river views</span>
            <span class="rr-badge"><i class="fas fa-road"></i>On NH 1, Andoo Road</span>
        </div>
        <h1>{{heroTitle}}</h1>
        <p>{{heroLead}}</p>
        <div class="d-flex flex-wrap mt-4">
            <a class="rr-btn mr-3 mb-3" href="/contact#booking"><i class="fas fa-calendar-check mr-2"></i>Check Availability</a>
            <a class="rr-btn-outline mb-3" href="/gallery"><i class="fas fa-images mr-2"></i>View Gallery</a>
        </div>
    </div>
</section>
