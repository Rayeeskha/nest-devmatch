 <main>
    <section class="rr-section">
      <div class="container">
        <div class="row align-items-stretch">
          <div class="col-lg-5 mb-4 mb-lg-0">
            <div class="rr-contact-panel h-100">
              <span class="rr-kicker">Hotel details</span>
              <h2>Direct contact for rooms, food, and arrival timing.</h2>
              <p>For fast availability, call or send your travel dates on WhatsApp. The hotel team can help confirm room options, route timing, food needs, and directions.</p>
              <div class="rr-contact-actions">
                <a class="rr-btn" href="{{contact.primaryMobile.telHref}}"><i class="fas fa-phone-alt mr-2"></i>Call Hotel</a>
                <a class="rr-btn-outline rr-btn-light" href="{{contact.whatsapp.checkAvailability}}" target="_blank" rel="noopener"><i class="fab fa-whatsapp mr-2"></i>WhatsApp</a>
              </div>
              <div class="rr-contact-list">
                <div>
                  <i class="fas fa-map-marker-alt"></i>
                  <span>NH 1, Andoo Road, Kargil, Ladakh 194103</span>
                </div>
                <div>
                  <i class="fas fa-phone-alt"></i>
                  <span><a href="{{contact.primaryMobile.telHref}}">{{contact.primaryMobile.display}}</a> / <a href="{{contact.secondaryMobile.telHref}}">{{contact.secondaryMobile.display}}</a></span>
                </div>
                <div>
                  <i class="fas fa-road"></i>
                  <span>Convenient access for Srinagar, Leh, Zanskar, and local Kargil travel.</span>
                </div>
              </div>
              <div class="owl-carousel rr-contact-slider">
                <div class="rr-contact-slide">
                  <img src="assets/gallary/front_hotel.jpeg" alt="Riverside Royale hotel front in Kargil" loading="lazy">
                  <span>Hotel exterior</span>
                </div>
                <div class="rr-contact-slide">
                  <img src="assets/gallary/room2.jpeg" alt="Riverside Royale guest room in Kargil" loading="lazy">
                  <span>Comfort rooms</span>
                </div>
                <div class="rr-contact-slide">
                  <img src="assets/gallary/cafe2.jpeg" alt="Riverside Royale cafe dining area" loading="lazy">
                  <span>Cafe dining</span>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-7" id="booking">
            <div class="rr-panel rr-booking-card h-100">
              <span class="rr-kicker">Check availability</span>
              <h2 class="rr-title h1">Send a booking enquiry</h2>
              <p class="rr-lead">Share your travel dates and requirements. Your enquiry opens directly in WhatsApp for quicker hotel confirmation.</p>
              <form class="js-whatsapp-form" data-phone="{{contact.whatsapp.number}}">
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="rr-form-label" for="name">Name</label>
                    <input class="rr-input" id="name" name="Name" data-label="Name" type="text" placeholder="Your name" required>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="rr-form-label" for="phone">Phone</label>
                    <input class="rr-input" id="phone" name="Phone" data-label="Phone" type="tel" placeholder="Your phone number" required>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="rr-form-label" for="arrival">Arrival</label>
                    <input class="rr-input" id="arrival" name="Arrival" data-label="Arrival" type="date">
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="rr-form-label" for="departure">Departure</label>
                    <input class="rr-input" id="departure" name="Departure" data-label="Departure" type="date">
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="rr-form-label" for="guests">Guests</label>
                    <select class="rr-select" id="guests" name="Guests" data-label="Guests">
                      <option value="2 Guests">2 Guests</option>
                      <option value="3 Guests">3 Guests</option>
                      <option value="4 Guests">4 Guests</option>
                      <option value="5+ Guests">5+ Guests</option>
                    </select>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="rr-form-label" for="room">Room type</label>
                    <select class="rr-select" id="room" name="Room" data-label="Room">
                      <option value="Deluxe Room">Deluxe Room</option>
                      <option value="Family Stay">Family Stay</option>
                      <option value="Route Traveler Room">Route Traveler Room</option>
                    </select>
                  </div>
                  <div class="col-12 mb-3">
                    <label class="rr-form-label" for="message">Message</label>
                    <textarea class="rr-textarea" id="message" name="Message" data-label="Message" placeholder="Arrival time, meal request, pickup support, or special requirement"></textarea>
                  </div>
                  <div class="col-12">
                    <button class="rr-btn" type="submit"><i class="fab fa-whatsapp mr-2"></i>Send on WhatsApp</button>
                    <a class="rr-btn-outline ml-md-3 mt-3 mt-md-0" style="color: var(--rr-navy); border-color: var(--rr-line);" href="{{contact.primaryMobile.telHref}}">Call Hotel</a>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rr-section rr-section-soft">
      <div class="container">
        <div class="text-center mb-5">
          <span class="rr-kicker">Location</span>
          <h2 class="rr-title">Find Riverside Royale on Google Maps.</h2>
          <p class="rr-lead mx-auto">Use the embedded map for the exact Riverside Royale location at NH 1, Andoo Road, Kargil, Ladakh.</p>
        </div>
        <div class="row align-items-stretch">
          <div class="col-lg-8 mb-4 mb-lg-0">
            <div class="rr-map-embed h-100">
              <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3286.2828806753682!2d76.14848239999999!3d34.546392399999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38e3236479bb647d%3A0xd26e0a9a1905715f!2sRiverside%20royale!5e0!3m2!1sen!2sin!4v1785342859196!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="Riverside Royale Google Map"></iframe>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="rr-panel h-100 rr-faq">
              <span class="rr-kicker">Quick answers</span>
              <h2 class="rr-title h1">Booking FAQ</h2>
              <details open>
                <summary>How do I book a room?</summary>
                <p>Call the hotel or submit the WhatsApp enquiry form with your dates, guest count, and preferred room type.</p>
              </details>
              <details>
                <summary>Where is Riverside Royale located?</summary>
                <p>The hotel is at NH 1, Andoo Road, Kargil, Ladakh 194103.</p>
              </details>
              <details>
                <summary>Is food available at the hotel?</summary>
                <p>Yes, Riverside Royale has cafe and dining support for guests. Confirm meal timing directly with the hotel.</p>
              </details>
              <details>
                <summary>Is parking available?</summary>
                <p>The hotel supports road travelers arriving by car, taxi, or bike. Confirm space when booking during peak dates.</p>
              </details>
              <a class="rr-btn mt-4" href="https://www.google.com/maps/search/?api=1&query=Riverside+Royale+NH+1+Andoo+Road+Kargil+Ladakh+194103" target="_blank" rel="noopener">Open Google Maps</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
